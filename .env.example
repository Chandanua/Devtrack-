# DevTrack Environment Configuration Example
# Copy this file to .env and fill in appropriate values for your environment.

# Database connection URL (Neon PostgreSQL - cloud hosted)
DATABASE_URL="postgresql://neondb_owner:your_password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# For local development, you can still use a local PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/devtrack"

# Authentication & Security (REQUIRED: Must be secure random strings in production)
JWT_SECRET="your-32-character-or-longer-random-secret-key"
JWT_EXPIRES_IN="7d"

# Encryption key for securing sensitive tokens at rest (32-byte base64 string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="your-32-byte-base64-encryption-key"

# Storage Settings
UPLOAD_DIR="./uploads"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_key"

# Google OAuth Integration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email Integration
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="DevTrack <notifications@yourdomain.com>"

